{
  "name": "repo-tool-insights",
  "version": "0.1.0",
  "description": "Analytics platform that measures whether contributors actually use the tools a project adopts.",
  "type": "module",
  "main": "dist/server/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch server/server.ts",
    "worker": "tsx watch server/modules/scans/scan.worker.ts",
    "build": "tsc",
    "build:frontend": "echo 'Frontend build not yet wired — see src/'",
    "start": "node dist/server/server.js",
    "migrate": "node scripts/migrate.js",
    "typecheck": "tsc --noEmit",
    "typecheck:frontend": "echo 'Frontend typecheck not yet wired — see tsconfig.frontend.json'",
    "lint": "eslint server --ext .ts",
    "format": "prettier --write \"server/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "bullmq": "^5.12.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^2.0.2",
    "eslint": "^9.6.0",
    "prettier": "^3.3.2",
    "supertest": "^7.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.2"
  }
}